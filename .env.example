APP_ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:5432/orchestrator
REDIS_URL=redis://localhost:6379/0

# robotics-backend: valida los tokens de los usuarios (GET /api/auth/me)
ROBOTICS_BACKEND_URL=http://localhost:8090

# Flussonic
FLUSSONIC_URL=http://localhost:8080
FLUSSONIC_USER=
FLUSSONIC_PASSWORD=

# Almacenamiento local de clips
CLIPS_DIR=./data/clips

# Pipeline
FRAME_SAMPLE_FPS=1.0

# CORS del frontend Robot Control Interface (lista separada por comas)
CORS_ORIGINS=http://localhost:3000
